ex:特性 a ex:Performance ;
    rdfs:label "特性" ;
    ex:hasEvidence "空气动力学特性，提升飞行性能。" ;
    ex:supports_mission ex:飞行 .

ex:舵面 a ex:Structure ;
    rdfs:label "舵面" ;
    ex:affects ex:气动干扰 ;
    ex:hasEvidence "传统的刚性襟翼、副翼等舵面是提高飞行器升",
        "制避免了舵面与弹体的气动干扰。",
        "动变体过程中舵面偏转所产生的气动力及其变化规律展开了研究。",
        "角，下标表示对应舵面，Δx表示焦点位置。" ;
    ex:has_component ex:飞行器 ;
    ex:has_parameter ex:位置 ;
    ex:uses_method ex:偏转 .

ex:角度 a ex:Parameter ;
    rdfs:label "角度" ;
    ex:affects ex:俯仰力矩,
        ex:弯矩,
        ex:扭矩 ;
    ex:hasEvidence "动机翼均处于最高点时，即两侧的公转角度均为90 度时，该俯仰力矩最大。",
        "图 6.10 连杆上最大弯矩随公转角度的变化曲线 ......................................... 95",
        "图 6.11 连杆上最大扭矩随公转角度的变化曲线 ......................................... 95" .

ex:起降 a ex:Mission ;
    rdfs:label "起降" .

ex:间距 a ex:Parameter ;
    rdfs:label "间距" ;
    ex:affects ex:升力系数,
        ex:损失,
        ex:斜率,
        ex:零升攻角 ;
    ex:hasEvidence "2）当上下机翼的间距过近时，双翼之间的气动干扰会使双翼的升力系数",
        "位置，上下翼间距1 倍弦长以内时，双翼整体的零升攻角滞后了1 度左右。",
        "倍左右弦长位置，上下翼间距在1 倍弦长以内时，双翼整体的零升攻角提前了",
        "升力系数随上下翼间距的增加而减少。",
        "弦长左右位置，上下翼间距1 倍弦长以内时，上机翼的升力线斜率将大幅度提",
        "来看，双翼的上下翼间距越小，损失的升力越多，奥斯瓦尔德因子越低，气动",
        "长左右位置，上下翼间距1 倍弦长以内时，下机翼的升力线斜率将大幅度提" .

ex:位置 a ex:Parameter ;
    rdfs:label "位置" ;
    ex:affects ex:升力,
        ex:双翼气动,
        ex:失速攻角,
        ex:弯矩,
        ex:损失,
        ex:斜率,
        ex:最大升力系数,
        ex:机翼面积,
        ex:气动特性,
        ex:稳定性,
        ex:翼展,
        ex:零升攻角 ;
    ex:hasEvidence "1）上下机翼的位置关系对双翼气动性能的影响",
        "1）上下机翼的相对位置对于机翼展向气动特性的影响",
        "上方位置时，上机翼的零升攻角大幅提高，而下机翼的零升攻角大幅降低；",
        "上方位置时，双翼整体的零升攻角基本保持不变；",
        "中靠近翼稍的位置，在存放燃油的同时可以起到降低机翼弯矩的作用。",
        "为了进一步探究上下机翼的相对位置对于机翼展向气动特性的影响，首先",
        "位置，上下翼间距1 倍弦长以内时，双翼整体的零升攻角滞后了1 度左右。",
        "余位置时机翼的失速攻角基本不变。",
        "倍左右弦长位置，上下翼间距在1 倍弦长以内时，双翼整体的零升攻角提前了",
        "右位置，上下机翼间距在1 倍弦长左右时，机翼的失速攻角有小幅度提高，其",
        "图 4.11 上下机翼处于不同位置时双翼的零升攻角（上机翼弦长大于下机翼）",
        "图 4.12 上下机翼处于不同位置时双翼的升力线斜率（上机翼弦长大于下机翼）",
        "图 4.13 上下机翼处于不同位置时双翼的最大升力系数（上机翼弦长大于下机翼）",
        "图 4.14 上下机翼处于不同位置时双翼的失速攻角（上机翼弦长大于下机翼）",
        "图 4.15 上下机翼处于不同位置时双翼的零升攻角（下机翼弦长大于上机翼）",
        "图 4.16 上下机翼处于不同位置时双翼的升力线斜率（下机翼弦长大于上机翼）",
        "图 4.17 上下机翼处于不同位置时双翼的最大升力系数（下机翼弦长大于上机翼）",
        "图 4.18 上下机翼处于不同位置时双翼的失速攻角（下机翼弦长大于上机翼）",
        "图 4.20 上下机翼处于不同位置时双翼的升力线斜率（上机翼弯度大于下机翼）",
        "图 4.21 上下机翼处于不同位置时双翼的最大升力系数（上机翼弯度大于下机翼）",
        "图 4.22 上下机翼处于不同位置时双翼的失速攻角（上机翼弯度大于下机翼）",
        "图 4.23 上下机翼处于不同位置时双翼的零升攻角（上机翼弯度小于下机翼）",
        "图 4.25 上下机翼处于不同位置时双翼的最大升力系数（上机翼弯度小于下机翼）",
        "图 4.26 上下机翼处于不同位置时双翼的失速攻角（上机翼弯度小于下机翼）",
        "图 4.5 上下机翼处于不同位置时机翼的零升攻角",
        "图 4.5 为上下机翼处于不同相对位置时，双翼整体和上下机翼的零升攻角",
        "图 4.6 上下机翼处于不同位置时机翼的升力线斜率",
        "图 4.6 为上下机翼处于不同相对位置时，双翼整体和上下机翼各自的升力",
        "图 4.8 上下机翼处于不同位置时机翼的最大升力系数",
        "图 4.9 上下机翼处于不同位置时机翼的失速攻角",
        "失，当上机翼处于下机翼斜前方时，损失的最大升力系数较少，在其余位置，",
        "度考虑，间断位置可以设置在更偏向翼尖的位置，此时活动机翼面积较小，活",
        "弦长左右位置，上下翼间距1 倍弦长以内时，上机翼的升力线斜率将大幅度提",
        "构型翼展固定的情况下，间断位置决定了活动机翼（上翼）和固定机翼（下",
        "纵向静稳定性与固定翼飞行器相似，随重心位置",
        "长左右位置，上下翼间距1 倍弦长以内时，下机翼的升力线斜率将大幅度提" .

ex:几何 a ex:Parameter ;
    rdfs:label "几何" ;
    ex:affects ex:攻角 ;
    ex:hasEvidence "包括几何扭转和气动扭转两种，前者是降低翼尖的攻角，后者是降低翼尖的翼" .

ex:副翼 a ex:ControlMethod ;
    rdfs:label "副翼" ;
    ex:affects ex:升力,
        ex:失速,
        ex:范围,
        ex:阻力 ;
    ex:applies_to ex:飞行器 ;
    ex:hasEvidence "2）在飞行控制方面，可以使固定机翼的副翼适当下偏进行升力",
        "4.4 气动力驱动变体的副翼特性研究 ........................................................ 70",
        "于副翼面积占机翼总面积的比例较小，副翼偏转所产生的俯仰力矩也影响较",
        "传统的刚性襟翼、副翼等舵面是提高飞行器升",
        "体的代价，气动力驱动变体所需的副翼铰链力矩相较于作动器直接驱动减小了",
        "分别为副翼面积和机翼参考",
        "则活动机翼的副翼上偏角度为：",
        "动机翼副翼的大幅差动，减小因副翼差动带来的不平衡阻力。",
        "升力系数较低，机翼和副翼有足够的线性升力和气动力冗余，只需要很小的副翼",
        "变体包线，当活动机翼的副翼面积占比为25%时，其变体包线的范围相较于",
        "变体开始后，活动机翼的副翼开始下偏，升力增加，驱",
        "可以看出，增大活动机翼的副翼面积可以大幅扩展飞机的",
        "固定时，活动机翼的内侧副翼将向上偏转，通过负升力使活动机翼保持在固定",
        "在变体过程中，当活动机翼两侧的副翼差动偏转时，两侧的阻力不平衡，",
        "在变形过程中，随着机翼位置的变化和副翼的偏转，活动机翼的升力大小",
        "当副翼的偏转角度过大时，将会引起机翼失速。",
        "方面，可以对副翼的气动外形做专门的优化，减少副翼偏转时产生的阻力。",
        "最后，开展了单-双折叠翼变体的副翼特性研究，以NACA2412 翼型为例，",
        "根据上文中的分析结果，全机的副翼面积占比可以按20%计算。",
        "算结果，可以进一步计算得到活动机翼的副翼不同面积占比时飞机的变体包",
        "纳入考量，其中副翼重量使用如下式计算[96]：",
        "经ACADO 计算，此时固定机翼副翼可产生的最大滚转控制力矩",
        "讨论了基于变体包线的单-双折叠翼变体的副翼参数设计方法；",
        "需副翼铰链力矩的300 多倍，这充分体现了气动力驱动变体的优势。" ;
    ex:has_component ex:固定机翼,
        ex:铰链 ;
    ex:has_parameter ex:参数,
        ex:角度,
        ex:重量,
        ex:面积 ;
    ex:is_a ex:特性 .

ex:折叠机翼 a ex:Mechanism ;
    rdfs:label "折叠机翼" ;
    ex:affects ex:载荷,
        ex:面积 ;
    ex:hasEvidence "但是，折叠机翼连接结构复杂、承受载荷大，",
        "变体机构（如折叠机翼折叠转轴处）气动载荷进",
        "图41 Z 型折叠机翼飞翼布局方案［69］",
        "形，总结伸缩机翼、可变后掠机翼、折叠机翼等机",
        "折叠机翼技术可以大幅度改变翼面积，与伸",
        "折叠机翼的大结构变形，上述基于非线性系统辨",
        "方案、折叠机翼方案的舵面效率随着马赫数的增",
        "早期的折叠机翼技术主要针对翼尖折叠，受驱动",
        "机气动特性的折叠机翼技术得到了广泛关注。",
        "［71］尹文强， 安然， 安玉娇. 飞翼布局折叠机翼变体飞机操稳" ;
    ex:has_component ex:变体飞机,
        ex:变形,
        ex:布局方案,
        ex:折叠,
        ex:机翼,
        ex:气动特性,
        ex:翼尖折叠,
        ex:舵面 .

ex:攻角 a ex:Parameter ;
    rdfs:label "攻角" ;
    ex:affects ex:俯仰力矩,
