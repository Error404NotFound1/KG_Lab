    ex:is_a ex:倾转 .

ex:前掠 a ex:Parameter ;
    rdfs:label "前掠" ;
    ex:affects ex:升力系数,
        ex:气动 ;
    ex:hasEvidence "变前掠角以达到最优气动性能。",
        "角下前掠翼对应升力系数较大，失速迎角最大，" .

ex:副翼偏转 a ex:ControlMethod ;
    rdfs:label "副翼偏转" ;
    ex:affects ex:俯仰力矩,
        ex:力矩,
        ex:升力,
        ex:压力分布,
        ex:机翼升力,
        ex:气动力,
        ex:阻力 ;
    ex:hasEvidence "于副翼面积占机翼总面积的比例较小，副翼偏转所产生的俯仰力矩也影响较",
        "副翼偏转将会产生较大的俯仰力矩，在设计中",
        "副翼偏转所产生的额外气动力有相对固定的作用中心，同时副翼偏转所引",
        "化远小于因副翼偏转所产生的俯仰力矩变化，因此在设计中应更多考虑副翼偏",
        "变化和副翼偏转角度变化而产生的俯仰力矩，则连杆与活动机翼的连接点可以",
        "图 3.6 当副翼偏转时，压力分布变化使副翼铰链处产生相反的力矩",
        "图 3.6 当副翼偏转时，压力分布变化使副翼铰链处产生相反的力矩 ........... 31",
        "图 4.55 副翼偏转时机翼升力的变化情况 .................................................... 72",
        "图 4.56 副翼偏转时机翼阻力的变化情况 .................................................... 72",
        "图 4.57 不同副翼面积的机翼在不同攻角下副翼偏转时俯仰力矩变化情况.. 73",
        "图 4.59 以RQ-4A 为原准机，副翼偏转所产生的额外力和力矩 .................. 75",
        "定机翼的升力来补偿副翼偏转带来的升力损失，以保证飞行的稳定，这需要机翼",
        "性展开了研究，分析了副翼偏转对机翼升力、阻力和力矩特性的影响。",
        "控制自转、公转和卸载升力所需的最大副翼偏转角约为20 度，而验证机",
        "补偿，从而减少活动机翼的副翼偏转角度；",
        "通过数值计算分析了变体过程中副翼偏转所产生的气动力的变化情况。" ;
    ex:has_component ex:机翼 ;
    ex:has_parameter ex:俯仰力矩,
        ex:升力,
        ex:角度 .

