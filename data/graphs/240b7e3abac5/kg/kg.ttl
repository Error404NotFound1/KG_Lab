    rdfs:label "阻力比较" .

ex:非定常 a ex:Performance ;
    rdfs:label "非定常" .

ex:飞机平面外形 a ex:Structure ;
    rdfs:label "飞机平面外形" ;
    ex:hasEvidence "果，以及飞机平面外形设计参数对单-双折叠翼变体的影响和气动力驱动变体" ;
    ex:has_parameter ex:参数 .

ex:飞行器总体设计 a ex:Mission ;
    rdfs:label "飞行器总体设计" .

ex:飞行器气动 a ex:Performance ;
    rdfs:label "飞行器气动" .

ex:飞行试验 a ex:Mission ;
    rdfs:label "飞行试验" .

ex:飞行试验验证 a ex:Mission ;
    rdfs:label "飞行试验验证" .

