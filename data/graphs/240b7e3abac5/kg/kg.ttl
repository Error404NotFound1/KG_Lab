    rdfs:label "验证" .

<http://example.org/kg/10°> a ex:Parameter ;
    rdfs:label "10°" .

<http://example.org/kg/2°> a ex:Parameter ;
    rdfs:label "2°" .

<http://example.org/kg/6°> a ex:Parameter ;
    rdfs:label "6°" .

ex:使用气动力驱动变体 a ex:Mechanism ;
    rdfs:label "使用气动力驱动变体" .

ex:偏转 a ex:ControlMethod ;
    rdfs:label "偏转" ;
    ex:affects ex:俯仰力矩,
        ex:力矩,
        ex:升力,
        ex:压力分布,
        ex:失速,
        ex:攻角,
        ex:斜率,
        ex:气动,
        ex:气动力,
        ex:阻力 ;
    ex:hasEvidence "上机翼后会向下偏转，使下机翼的实际攻角降低，进而使下机翼的升力线斜率",
        "下偏转的同时，还会产生一定量的差动，使活动机翼产生滚转力矩，从而控制活",
        "侧副翼上偏15 度，外侧副翼上偏5 度的极限偏转情况，俯仰力矩参考点取",
        "偏转就可以完成升力控制，在此工况下完成变体后，飞机进一步爬升至巡航高度",
        "偏转角度为线性关系，假设两侧的副翼的偏转角度为",
        "动变体过程中舵面偏转所产生的气动力及其变化规律展开了研究。",
        "固定时，活动机翼的内侧副翼将向上偏转，通过负升力使活动机翼保持在固定",
        "图 3.6 显示了一个典型的副翼上下偏转时，机翼的压力分布变化。",
        "在变形过程中，随着机翼位置的变化和副翼的偏转，活动机翼的升力大小",
        "当副翼的偏转角度过大时，将会引起机翼失速。",
        "果表明，在极限偏转的工况下，活动机翼向连杆传递的阻力约为900N，不对",
        "模式，通过副翼等气动舵面偏转产生的气动力驱动其在两种模式间进行切换。",
        "的上下偏转控制活动机翼的升力以驱动公转，两个副翼的差动控制活动机翼自",
        "翼偏转所产生的额外俯仰力矩。" ;
    ex:is_a ex:副翼 .

ex:动力学 a ex:Concept ;
    rdfs:label "动力学" ;
    ex:hasEvidence "明确其动力学特性，并制定合适的控制策略。",
        "的动力学特性展开直接分析，并建立出依赖于模型的控制方法。" ;
    ex:is_a ex:特性 .

ex:单翼 a ex:Concept ;
    rdfs:label "单翼" .

ex:双翼布局 a ex:Concept ;
    rdfs:label "双翼布局" .

ex:双翼构型 a ex:Concept ;
    rdfs:label "双翼构型" ;
    ex:hasEvidence "首先开展了双翼构型的气动特性研究，结合早年对于双翼布局的研究结果，提" ;
    ex:is_a ex:气动特性 .

ex:变体方式 a ex:Concept ;
    rdfs:label "变体方式" .

ex:变体飞行 a ex:Mission ;
    rdfs:label "变体飞行" .

ex:变体飞行器概念 a ex:Mission ;
    rdfs:label "变体飞行器概念" .

ex:安定 a ex:Performance ;
    rdfs:label "安定" .

ex:尺寸增加 a ex:Parameter ;
    rdfs:label "尺寸增加" .

ex:尾翼 a ex:Structure ;
    rdfs:label "尾翼" ;
    ex:hasEvidence "尾翼，其平尾面积和垂尾面积进行了等效折算。",
        "翼和尾翼舵面的设计参数相较于原准机也保持不变，由于全球鹰使用了V 型" ;
    ex:has_component ex:舵面 ;
    ex:has_parameter ex:参数,
        ex:面积 .

ex:展开 a ex:Mechanism ;
    rdfs:label "展开" ;
    ex:affects ex:气动力,
        ex:阻力 ;
    ex:hasEvidence "从上述计算结果中可以看出，折叠变体和展开变体过程中，飞机的气动力",
        "在从双翼到单翼的展开变体过程中，升阻力随公转角度" .

ex:展弦比飞行器 a ex:Aircraft ;
    rdfs:label "展弦比飞行器" ;
    ex:hasEvidence "了大展弦比飞行器气动-重量-性能的等价关系，以“全球鹰”为原准机，讨论了",
        "图 1.5 不同年代的大展弦比飞行器的翼展 .................................................... 4" ;
    ex:has_parameter ex:翼展,
        ex:重量 .

ex:布局 a ex:Concept ;
    rdfs:label "布局" ;
    ex:hasEvidence "连接翼布局在某种形式上可以看做是双翼布局的一种" ;
    ex:is_a ex:双翼布局 .

ex:机翼间距 a ex:Parameter ;
    rdfs:label "机翼间距" ;
    ex:affects ex:斜率,
        ex:气动,
        ex:气动力 ;
    ex:hasEvidence "上下机翼间距：上下机翼间距增加有助于改善飞机在双翼布局下的气动",
        "于双翼布局气动力特性的研究，上下机翼间距在一倍左右平均气动弦长时，可",
        "线斜率随着上机翼和下机翼间距的增加而增加。" .

ex:机翼面积 a ex:Parameter ;
    rdfs:label "机翼面积" .

ex:活动 a ex:Mechanism ;
    rdfs:label "活动" ;
    ex:hasEvidence "并转移至固定机翼，减小梢根比也有利于减少需要转移的升力，降低对于活动" ;
    ex:has_component ex:固定机翼 .

ex:约束 a ex:ControlMethod ;
    rdfs:label "约束" ;
    ex:applies_to ex:长航,
        ex:飞机,
        ex:飞行器 ;
    ex:hasEvidence "单-双折叠翼变体在飞机总体设计中引入的新要求、新参数、新约束，研究了",
        "场地和气象条件限制等约束，为飞行器选择最优的翼展和展弦比。",
        "技术应用于飞行器，则意味着原有的设计约束被打破，飞机在原有的设计约束下",
        "约束，拓展飞机的飞行包线，改善飞机在不同阶段的飞行性能。",
        "计约束与新设计要求与现有的大展弦比长航时飞行器的设计准则无明显矛盾，" ;
    ex:has_parameter ex:参数,
        ex:展弦比,
        ex:翼展 .

ex:翼尖 a ex:Structure ;
    rdfs:label "翼尖" ;
    ex:affects ex:升力系数,
        ex:失速 ;
    ex:hasEvidence "当梢根比过小时，机翼翼尖容易发生失速。",
        "距为1 倍弦长的情况下，将翼尖处的上下翼间距增大到1.5 倍弦长，从而构造了",
        "采用了大三角翼的设计，其翼尖与主机翼之间以铰链连接，在高速飞行时XB-70",
        "采用负扭转角的设计，从而降低翼尖的升力系数，防止翼尖失速。" ;
    ex:has_component ex:机翼 ;
    ex:has_parameter ex:间距 .

ex:起飞重量 a ex:Parameter ;
    rdfs:label "起飞重量" ;
    ex:affects ex:起降翼展 ;
    ex:hasEvidence "大起飞重量时，变体RQ-4A 相较于相同起降翼展的RQ-4A 原准机已经几乎无" .

ex:距离 a ex:Parameter ;
    rdfs:label "距离" ;
    ex:affects ex:失速,
        ex:斜率 ;
    ex:hasEvidence "后距离较长时，机翼的失速将会有小幅度推迟。",
        "的距离越大，双翼的升力线斜率越高，当上翼位于下翼正前方，且距离较近" .

ex:长航 a ex:Mission ;
    rdfs:label "长航" .

ex:wing a ex:Structure ;
    rdfs:label "wing" ;
    ex:hasEvidence "Flow situation of movable and fixed wings at the beginning of morphing.",
        "and morphing wings is the same, then:",
        "around the fixed wing is set at 10° per second, with",
        "at the hinges. The morphing motion of the wings can",
        "force characteristics of the wing and morphing mechanism during the morphing process",
        "morphing aircraft when fixed-wing ailerons compensating",
        "morphing process, the ailerons on the fixed wing",
        "movable wing during the morphing process. It can be",
        "movable wings during the morphing process.",
        "wing ailerons during the morphing process can be",
        "wing morphing primarily arise from the variation in" ;
    ex:has_component ex:morphing ;
    ex:has_mechanism ex:morphing ;
    ex:has_parameter <http://example.org/kg/10°> ;
    ex:uses_method ex:morphing .

ex:副翼偏转 a ex:ControlMethod ;
    rdfs:label "副翼偏转" ;
    ex:affects ex:俯仰力矩,
        ex:力矩,
        ex:升力,
        ex:压力分布,
        ex:失速,
        ex:机翼升力,
        ex:气动力,
        ex:阻力 ;
    ex:hasEvidence "15 度，外侧副翼偏转5 度的极限偏转情形时，活动机翼的总阻力约为900",
        "于副翼面积占机翼总面积的比例较小，副翼偏转所产生的俯仰力矩也影响较",
        "化远小于因副翼偏转所产生的俯仰力矩变化，因此在设计中应更多考虑副翼偏",
        "变化和副翼偏转角度变化而产生的俯仰力矩，则连杆与活动机翼的连接点可以",
        "图 3.6 当副翼偏转时，压力分布变化使副翼铰链处产生相反的力矩",
        "图 3.6 当副翼偏转时，压力分布变化使副翼铰链处产生相反的力矩 ........... 31",
        "图 4.54 副翼偏转的几何构型",
        "图 4.55 副翼偏转时机翼升力的变化情况",
        "图 4.55 副翼偏转时机翼升力的变化情况 .................................................... 72",
        "图 4.56 副翼偏转时机翼阻力的变化情况",
        "图 4.56 副翼偏转时机翼阻力的变化情况 .................................................... 72",
        "图 4.57 不同副翼面积的机翼在不同攻角下副翼偏转时俯仰力矩变化情况",
        "定机翼的升力来补偿副翼偏转带来的升力损失，以保证飞行的稳定，这需要机翼",
        "当副翼偏转时，机翼的升力大小和升力中心位",
        "当副翼偏转角度进一步增大时，则会出现失速的情",
        "性展开了研究，分析了副翼偏转对机翼升力、阻力和力矩特性的影响。",
        "折叠翼变体飞机为例，定量分析了副翼偏转所产生的额外力和力矩。",
        "方面，可以对副翼的气动外形做专门的优化，减少副翼偏转时产生的阻力。",
        "称阻力产生的扭转力矩约1150N·m，副翼偏转产生的俯仰力矩约为3200",
        "程中，全机的升力需重新分配，活动机翼的升力将通过副翼偏转卸载一部分，",
        "程中，副翼偏转是否能够提供足够的气动力和气动力矩，直接关系到变体的成",
        "补偿，从而减少活动机翼的副翼偏转角度；",
        "转角度的变化而改变，即副翼偏转产生的额外气动力的作用中心处于45%弦",
        "通过数值计算分析了变体过程中副翼偏转所产生的气动力的变化情况。" ;
