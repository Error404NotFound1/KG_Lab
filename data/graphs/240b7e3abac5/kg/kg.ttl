ex:折叠变体 a ex:Mechanism ;
    rdfs:label "折叠变体" ;
    ex:affects ex:升力,
        ex:气动力 ;
    ex:applies_to ex:飞机 ;
    ex:hasEvidence "从上述计算结果中可以看出，折叠变体和展开变体过程中，飞机的气动力",
        "从计算结果可以看出，在由单翼向双翼的折叠变体过程中，升力呈逐步下降趋",
        "力，基本不改变飞机的有效升力面积，相比之下，传统的机翼折叠变体在折叠状",
        "驱动折叠变体所需要的铰链力矩、作动器直接驱动变体所需要作动器力矩、以" ;
    ex:has_component ex:铰链 .

ex:改善飞机 a ex:Concept ;
    rdfs:label "改善飞机" .

ex:方式 a ex:Concept ;
    rdfs:label "方式" .

ex:方案 a ex:Concept ;
    rdfs:label "方案" .

ex:无人机 a ex:Aircraft ;
    rdfs:label "无人机" ;
    ex:hasEvidence "3）在“全球鹰”无人机基础上，可以通过单-双折叠翼变体，在",
        "“全球鹰”无人机为例，其翼展近40 米，若想实现航母起降，则其起降翼展需",
        "下面以基于RQ-4A 无人机的单-双折叠翼变体飞机为例，定量分析副翼偏" ;
    ex:has_parameter ex:翼展 ;
    ex:is_a ex:变体飞机 ;
    ex:uses_method ex:折叠 .

ex:最大升力 a ex:Parameter ;
    rdfs:label "最大升力" .

ex:机构复杂 a ex:Concept ;
    rdfs:label "机构复杂" .

ex:机翼副翼 a ex:Structure ;
    rdfs:label "机翼副翼" ;
    ex:hasEvidence "机翼副翼的设计参数。" ;
    ex:has_parameter ex:参数 .

ex:机翼副翼不同面积 a ex:Parameter ;
    rdfs:label "机翼副翼不同面积" .

ex:机翼向上运动 a ex:ControlMethod ;
    rdfs:label "机翼向上运动" .

ex:机翼固定 a ex:Structure ;
    rdfs:label "机翼固定" .

ex:机翼处于单翼构型 a ex:Structure ;
    rdfs:label "机翼处于单翼构型" .

ex:机翼处于单翼状态 a ex:Structure ;
    rdfs:label "机翼处于单翼状态" .

ex:机翼需要卸载 a ex:ControlMethod ;
    rdfs:label "机翼需要卸载" ;
    ex:affects ex:升力系数 ;
    ex:hasEvidence "布不变，则活动机翼需要卸载的升力系数为：" .

ex:机身发动机 a ex:Mechanism ;
    rdfs:label "机身发动机" ;
    ex:hasEvidence "“全球鹰”为例，其主油箱布置于机身发动机的下方，两个副油箱布置于机翼" ;
    ex:has_component ex:机翼 .

ex:机身布局 a ex:Structure ;
    rdfs:label "机身布局" .

ex:构型 a ex:Concept ;
    rdfs:label "构型" .

ex:构型双翼 a ex:Concept ;
    rdfs:label "构型双翼" .

ex:检验飞机 a ex:Mission ;
    rdfs:label "检验飞机" .

ex:气动优化 a ex:Concept ;
    rdfs:label "气动优化" .

ex:气动力驱动 a ex:Mechanism ;
    rdfs:label "气动力驱动" ;
    ex:hasEvidence "用边界，发展完善了气动力驱动的单-双折叠翼变体的新概念。" ;
    ex:has_component ex:折叠 .

ex:气动力驱动变体 a ex:Mechanism ;
    rdfs:label "气动力驱动变体" ;
    ex:affects ex:翼展 ;
    ex:hasEvidence "3.3.2 气动力驱动变体与作动器直接驱动变体的比较",
        "4.4 气动力驱动变体的副翼特性研究 ........................................................ 70",
        "与传统的变体方式相比，气动力驱动变体是通过驱动副翼或其他气动舵面",
        "体的代价，气动力驱动变体所需的副翼铰链力矩相较于作动器直接驱动减小了",
        "单-双折叠翼变体飞行器使用副翼偏转所产生的气动力驱动变体，副翼的",
        "即实现了6m 翼展的原理验证机大范围变体，也充分体现了气动力驱动变体的",
        "图 3.8 四种不同飞机上应用气动力驱动变体和作动器直接驱动变体所需的力",
        "在双翼构型下的气动特性、变体过程中的气动特性以及气动力驱动变体的副翼特",
        "在适应性方面，单-双折叠翼变体采用气动力驱动变体，其驱动力主要来自",
        "果，以及飞机平面外形设计参数对单-双折叠翼变体的影响和气动力驱动变体",
        "气动力驱动变体的变体方式，无需复杂的作动机构与作" ;
    ex:has_component ex:副翼,
        ex:机构,
        ex:舵面,
        ex:飞机 ;
    ex:is_a ex:折叠,
        ex:驱动变体 .

ex:求导 a ex:ControlMethod ;
    rdfs:label "求导" .

ex:活动机翼副翼 a ex:Structure ;
    rdfs:label "活动机翼副翼" .

