ex:由图可见 a ex:Concept ;
    rdfs:label "由图可见" ;
    ex:hasEvidence "由图可见，当x₀为零或负值时，即卜型翼颤振前向稳定性由对应转动刚度（Sₐ⩽0）而，出浮明显影响。",
        "考虑到翼肋的中下部分主要由梁腹板承受，由图可见，弦矩的变化规律是中间大两头小，结构设计中应使嵌合的面积适应内力的变化规律。" ;
    ex:is_a ex:刚度,
        ex:稳定,
        ex:转动 ;
