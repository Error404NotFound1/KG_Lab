        ex:减小,
        ex:卫星,
        ex:发展,
        ex:可得到,
        ex:固化,
        ex:复合材料,
        ex:实现,
        ex:描述,
        ex:数据,
        ex:最终,
        ex:条件,
        ex:比较,
        ex:真空,
        ex:研制单位,
        ex:纤维,
        ex:过程,
        ex:部件,
        ex:需要 ;
    ex:part_of ex:整体结构,
